# =============================================================================
# Scrapicook - Docker Ignore
# Files and directories to exclude from Docker build context
# =============================================================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Version control
.git
.gitignore
.gitattributes

# Environment files
.env
.env.local
.env.*.local
.env.example

# Generated files
generated/
dist/
build/
coverage/

# Testing
tests/
*.test.ts
*.spec.ts
playwright-report/
test-results/

# Documentation
documentation/
*.md
!README.md

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Docker files (avoid recursive copies)
Dockerfile
docker-compose*.yml
.dockerignore

# Prisma - migrations are handled separately
prisma/migrations/

# Misc
.editorconfig
.prettierrc
.eslintrc*
eslint.config.js
*.config.ts
!tsconfig.json
